# === SECURITY ===

# Block access to sensitive files
<FilesMatch "\.(php|log|json)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Allow specific PHP files that need web access
<FilesMatch "^(index|new_contact|recaptchalib|admin_fulfillment|checkout|comgate-callback|comgate-return|gitpull)\.php$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Block direct access to data directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# === PERFORMANCE ===

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresDefault "access plus 1 week"
</IfModule>

# === URL CANONICALIZATION ===

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force www
    RewriteCond %{HTTP_HOST} ^plushouse\.cz$ [NC]
    RewriteRule ^(.*)$ https://www.plushouse.cz/$1 [L,R=301]

    # Clean URLs — directory format serves the .html version
    RewriteRule ^plusconnect/?$ /plusconnect.html [L]
    RewriteRule ^audio/?$ /audio.html [L]
    RewriteRule ^pms/?$ /pms.html [L]
    RewriteRule ^trafostanice/?$ /trafostanice.html [L]
    RewriteRule ^fotovoltaika/?$ /fotovoltaika.html [L]

    # 301 redirects for duplicate .html ↔ /index.html pages
    # Canonical: /kontakt → kontakt.html (internal rewrite)
    RewriteCond %{REQUEST_URI} ^/kontakt/?$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^kontakt/?$ /kontakt.html [L]

    # Redirect /chytra-domacnost-loxone/ to canonical /chytra-domacnost-loxone/
    # (the /index.html version is canonical for this one — it has full CSS)
    RewriteRule ^chytra-domacnost-loxone\.html$ /chytra-domacnost-loxone/ [R=301,L]

    # Redirect /chytra-domacnost-olomouc.html to /chytra-domacnost-olomouc/
    RewriteRule ^chytra-domacnost-olomouc\.html$ /chytra-domacnost-olomouc/ [R=301,L]

    # Redirect /plusconnect/index.html (already handled by clean URL above)
    # Redirect /kontakt/index.html explicitly
    RewriteRule ^kontakt/index\.html$ /kontakt [R=301,L]
</IfModule>

# === ERROR PAGES ===
ErrorDocument 404 /404.html
